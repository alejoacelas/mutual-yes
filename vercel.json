{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/download",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/download",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mutual-yes.html\""
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "alias": [
    "mutual-yes-async-alejo.vercel.app"
  ],
  "build": {
    "env": {
      "PUBLIC_ORIGIN": "https://mutual-yes-async-alejo.vercel.app"
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
